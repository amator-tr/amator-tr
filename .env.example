# === Cloudflare Tunnel ===
CLOUDFLARE_TUNNEL_TOKEN=

# === Cloudflare AI (opsiyonel - moderation + asistan icin) ===
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# === Cloudflare Cache Purge (deploy.sh icin) ===
CLOUDFLARE_ZONE_ID=

# === Auth ===
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Turnstile CAPTCHA ===
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# === Email (Resend) ===
RESEND_API_KEY=

# === Role Export (protected endpoints) ===
PROTECTED_PASSWORD=
TOKEN_SECRET=

# === App ===
EMAIL_FROM=amator.tr <noreply@amator.tr>
APP_URL=https://cagri.amator.tr
PORT=3000
DB_PATH=./data/cagri.db

# === Admin Article Publishing ===
# Admin "Yayinla" butonu container icinden git commit + push yapar.
# DEPLOY_KEY_PATH: host'ta yazma yetkili SSH deploy key dosyasinin yolu.
# Bos birakilirsa /dev/null mount'lanir — publish akisi git push'ta basarisiz olur.
# Anahtar olusturma: ssh-keygen -t ed25519 -f ~/.ssh/amator_deploy -N ''
# Github repo Settings > Deploy keys > Add deploy key (Allow write access).
DEPLOY_KEY_PATH=
GIT_AUTHOR_NAME=Admin Publish
GIT_AUTHOR_EMAIL=admin@amator.tr
